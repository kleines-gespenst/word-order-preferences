1	ROOT	S

# BASE SENTENCE TYPES - These are selected probabilistically first
1	S	NP_Subj_S IVerb_S	1 # 2swaps
1	S	NP_Subj_P IVerb_P	1

1	S	NP_Subj_S NP_Obj TVerb_S	1 # 6 swaps
1	S	NP_Subj_P NP_Obj TVerb_P	1

1	S	NP_Subj_S VP_Comp_S	1
1	S	NP_Subj_P VP_Comp_P	1

1	IVerb_S	IVerb_Pres_S
1	IVerb_S	IVerb_Past_S
1	IVerb_P	IVerb_Pres_P
1	IVerb_P	IVerb_Past_P

1	TVerb_S	TVerb_Pres_S
1	TVerb_S	TVerb_Past_S
1	TVerb_P	TVerb_Pres_P
1	TVerb_P	TVerb_Past_P

1	VP_Comp_S	S_Comp Verb_Comp_S	2
1	VP_Comp_P	S_Comp Verb_Comp_P	2

1	Verb_Comp_S	Verb_Comp_Pres_S
1	Verb_Comp_S	Verb_Comp_Past_S
1	Verb_Comp_P	Verb_Comp_Pres_P
1	Verb_Comp_P	Verb_Comp_Past_P

# PARAMETER 3: Subordinator position (swap these 2 constituents)
1	S_Comp	S Comp	3

# Subject NPs
1	NP_Subj_S	NP_S Subj
1	NP_Subj_P	NP_P Subj

# Object NPs
1	NP_Obj	NP_S Obj
1	NP_Obj	NP_P Obj

# NP internal structure
1	NP_S	Noun_S
1	NP_P	Noun_P
0.2	NP_S	PP NP_S	4
0.2	NP_P	PP NP_P	4

# PARAMETER 4: Adposition order (swap these 2 constituents)
1	PP	NP_S Prep	4
1	PP	NP_P Prep	4

# PARAMETER 5: Adjective order (swap these 2 constituents)
1	NP_S	Adj Noun_S	5
1	NP_P	Adj Noun_P	5

1	Adj	Adj CC Adj

1	NP_S	VP_Rel_S Rel Noun_S	6
1	NP_P	VP_Rel_P Rel Noun_P	6

1	VP_Rel_S	IVerb_S
